<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <org.maplibre.android.maps.MapView android:id="@+id/mapView" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <!--  ========== TOP: logo + search + legend ==========  -->
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="12dp" android:paddingEnd="16dp" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_marginBottom="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_shield_logo"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/app_title" android:textColor="@color/jd_teal_dark" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="52dp" app:cardBackgroundColor="@color/jd_sheet" app:cardCornerRadius="18dp" app:cardElevation="6dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="18dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:importantForAccessibility="no" android:src="@drawable/ic_search" app:tint="@color/jd_muted"/>
                <EditText android:id="@+id/etSearch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="14dp" android:layout_weight="1" android:background="@null" android:hint="Mau ke mana?" android:imeOptions="actionSearch" android:importantForAutofill="no" android:inputType="text" android:maxLines="1" android:textColor="@color/jd_ink" android:textColorHint="@color/jd_muted" android:textSize="15sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/jd_sheet" app:cardCornerRadius="10dp" app:cardElevation="3dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingTop="7dp" android:paddingEnd="12dp" android:paddingBottom="7dp">
                <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/jd_aman"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="12dp" android:text="Aman" android:textColor="@color/jd_ink" android:textSize="10sp"/>
                <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/jd_waspada"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:layout_marginEnd="12dp" android:text="Waspada" android:textColor="@color/jd_ink" android:textSize="10sp"/>
                <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/bg_dot" android:backgroundTint="@color/jd_rawan"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="5dp" android:text="Rawan" android:textColor="@color/jd_ink" android:textSize="10sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <!--  ========== PERINGATAN LANGSUNG ==========  -->
    <com.google.android.material.card.MaterialCardView android:id="@+id/alertCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="14dp" app:cardBackgroundColor="@color/jd_sheet" app:cardCornerRadius="16dp" app:cardElevation="8dp" app:layout_constraintBottom_toTopOf="@+id/sheet" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
            <ImageView android:layout_width="34dp" android:layout_height="34dp" android:importantForAccessibility="no" android:src="@drawable/ic_alert_circle"/>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvAlertMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Peringatan langsung • 1 menit lalu" android:textColor="@color/jd_rawan" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvAlertTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Waspada di Jl. Duren Sawit Raya" android:textColor="@color/jd_teal_dark" android:textSize="14sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvAlertDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Risiko jambret meningkat dalam radius 300m" android:textColor="@color/jd_muted" android:textSize="10sp"/>
            </LinearLayout>
            <ImageView android:id="@+id/btnAlertClose" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="top" android:contentDescription="Tutup peringatan" android:padding="7dp" android:src="@drawable/ic_close" app:tint="@color/jd_muted"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!--  ========== BOTTOM SHEET: prediksi risiko + nav ==========  -->
    <LinearLayout android:id="@+id/sheet" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@drawable/bg_sheet" android:elevation="16dp" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <View android:layout_width="40dp" android:layout_height="4dp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" android:background="@drawable/bg_sheet_handle"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="14dp" android:paddingEnd="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.06" android:text="PREDIKSI RISIKO" android:textColor="@color/jd_muted" android:textSize="10sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/tvRiskTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Risiko meningkat malam ini" android:textColor="@color/jd_teal_dark" android:textSize="17sp" android:textStyle="bold"/>
                <TextView android:id="@+id/tvRiskBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_badge" android:paddingStart="14dp" android:paddingTop="5dp" android:paddingEnd="14dp" android:paddingBottom="5dp" android:text="Rawan" android:textColor="#D64545" android:textSize="12sp" android:textStyle="bold"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" android:weightSum="3">
                <TextView android:id="@+id/chipNow" style="@style/JdTimeChip" android:drawableStart="@drawable/ic_chip_clock" android:text="Sekarang"/>
                <TextView android:id="@+id/chip1h" style="@style/JdTimeChip" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:drawableStart="@drawable/ic_chip_clock" android:text="+1 jam"/>
                <TextView android:id="@+id/chipTonight" style="@style/JdTimeChip" android:drawableStart="@drawable/ic_chip_moon" android:text="Malam ini"/>
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:background="@color/jd_divider"/>
        <LinearLayout android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="3">
            <LinearLayout android:id="@+id/navMap" style="@style/JdNavItem">
                <ImageView style="@style/JdNavIcon" android:src="@drawable/ic_nav_map"/>
                <TextView style="@style/JdNavLabel" android:text="Peta"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navHistory" style="@style/JdNavItem">
                <ImageView style="@style/JdNavIcon" android:src="@drawable/ic_nav_history"/>
                <TextView style="@style/JdNavLabel" android:text="Riwayat"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/navReport" style="@style/JdNavItem">
                <ImageView style="@style/JdNavIcon" android:src="@drawable/ic_nav_report"/>
                <TextView style="@style/JdNavLabel" android:text="Laporkan"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>